# Always revalidate the SPA shell after Cloudflare deployment.
/ 
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Vite assets have content-hashed filenames; they can be cached safely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: no-cache
