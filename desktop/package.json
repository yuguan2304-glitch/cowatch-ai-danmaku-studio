{
  "name": "cowatch-alpha-desktop",
  "version": "0.2.1-alpha",
  "private": true,
  "description": "CoWatch Alpha Windows app",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.cowatch.alpha.desktop",
    "productName": "共映 Alpha",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CoWatch-Alpha-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "共映 Alpha"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuguan2304-glitch/cowatch-ai-danmaku-studio.git"
  }
}